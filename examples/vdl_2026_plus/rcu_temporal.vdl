//! VDL_2026+ Example: RCU with Temporal Properties
//!
//! Demonstrates VDL_2026+ temporal logic for specifying safety and liveness.
//!
//! This extends the basic RCU example with:
//! - Temporal safety properties (always)
//! - Temporal liveness properties (eventually)
//! - Fairness constraints
//!
//! Compared to VDL_2026, VDL_2026+ allows expressing properties like:
//! - "Callbacks are always eventually executed"
//! - "Grace periods always complete"
//! - "No reader starvation"

type RcuState = {
  readers: Set<Nat>,
  epoch: Nat,
  gpActive: Bool,
  pendingCallbacks: List<Callback>,
  completedCallbacks: List<Callback>
}

type Callback = {
  id: Nat,
  targetEpoch: Nat
}

//
// VDL_2026 Invariants (state-based)
//

inv callback_safety(s: RcuState) =
  forall cb in s.pendingCallbacks:
    cb.targetEpoch <= s.epoch

inv epoch_monotonic(s: RcuState) =
  s.epoch >= old(s.epoch)

inv max_readers(s: RcuState) =
  card(s.readers) <= 10

//
// VDL_2026+ Temporal Properties (LTL)
//

// SAFETY: Callbacks always safe (epoch constraint)
temporal property callback_safety_always =
  always(forall cb in state.pendingCallbacks:
    cb.targetEpoch <= state.epoch)

// SAFETY: Epoch monotonically increases
temporal property epoch_never_decreases =
  always(state.epoch >= prev(state.epoch))

// LIVENESS: Every callback eventually completes
temporal property callback_completion =
  always(
    exists cb in state.pendingCallbacks implies
    eventually(cb in state.completedCallbacks)
  )

// LIVENESS: Grace periods eventually complete
temporal property grace_period_progress =
  always(
    state.gpActive implies
    eventually(not state.gpActive)
  )

// FAIRNESS: No reader starvation
temporal property reader_fairness =
  always(
    forall r: Nat:
      infinitely_often(enabled(rcu_read_lock(state, r))) implies
      infinitely_often(r in state.readers)
  )

// LEADS-TO: Callback queued leads to completion
temporal property callback_leads_to_completion =
  forall cb: Callback:
    (cb in state.pendingCallbacks) leads_to (cb in state.completedCallbacks)

//
// Transitions (same as VDL_2026)
//

transition rcu_read_lock(s: RcuState, r: Nat) -> RcuState
pre r not_in s.readers and card(s.readers) < 10
post s'.readers == s.readers union {r} and
     s'.epoch == s.epoch and
     s'.gpActive == s.gpActive and
     s'.pendingCallbacks == s.pendingCallbacks and
     s'.completedCallbacks == s.completedCallbacks

transition rcu_read_unlock(s: RcuState, r: Nat) -> RcuState
pre r in s.readers
post s'.readers == s.readers \ {r} and
     s'.epoch == s.epoch and
     s'.gpActive == s.gpActive and
     s'.pendingCallbacks == s.pendingCallbacks and
     s'.completedCallbacks == s.completedCallbacks

transition start_grace_period(s: RcuState) -> RcuState
pre not s.gpActive and card(s.readers) == 0
post s'.readers == s.readers and
     s'.epoch == s.epoch + 1 and
     s'.gpActive == true and
     s'.pendingCallbacks == s.pendingCallbacks and
     s'.completedCallbacks == s.completedCallbacks

transition end_grace_period(s: RcuState) -> RcuState
pre s.gpActive and card(s.readers) == 0
post s'.readers == s.readers and
     s'.epoch == s.epoch and
     s'.gpActive == false and
     s'.pendingCallbacks == s.pendingCallbacks and
     s'.completedCallbacks == s.completedCallbacks

transition call_rcu(s: RcuState, cb_id: Nat) -> RcuState
pre cb_id not_in dom(map_from_list(s.pendingCallbacks))
post let cb = {id = cb_id, targetEpoch = s.epoch} in
     s'.readers == s.readers and
     s'.epoch == s.epoch and
     s'.gpActive == s.gpActive and
     s'.pendingCallbacks == s.pendingCallbacks ++ [cb] and
     s'.completedCallbacks == s.completedCallbacks

transition run_ready_callbacks(s: RcuState) -> RcuState
pre exists cb in s.pendingCallbacks: cb.targetEpoch <= s.epoch
post let (ready, not_ready) = partition s.pendingCallbacks (λcb. cb.targetEpoch <= s.epoch) in
     s'.readers == s.readers and
     s'.epoch == s.epoch and
     s'.gpActive == s.gpActive and
     s'.pendingCallbacks == not_ready and
     s'.completedCallbacks == s.completedCallbacks ++ ready

//
// VDL_2026+ vs TLA+ Comparison
//

/*
TLA+ version would require:

Safety == □[TypeInv ∧ CallbackSafety]_vars
Liveness == ∀cb ∈ PendingCallbacks: cb ∈ PendingCallbacks ~> cb ∈ CompletedCallbacks

VDL_2026+ advantages:
1. ASCII-friendly syntax (always vs □, eventually vs ◇)
2. Integrated with state-based specifications
3. Explicit transition definitions
4. Built-in model checking (no separate TLC needed)
5. Composable temporal operators

TLA+ advantages:
1. Mature tooling (TLC, TLAPS)
2. Large user community
3. Proven industrial use (AWS, Azure)

VDL_2026+ aims to match TLA+ expressiveness with better ergonomics.
*/

//
// How to Use
//

/*
1. Parse: vdl_2026_plus parse rcu_temporal.vdl
2. Model check safety:
     vdl_2026_plus check callback_safety_always --depth 20
3. Model check liveness:
     vdl_2026_plus check callback_completion --depth 50 --fairness weak
4. Verify all properties:
     vdl_2026_plus verify rcu_temporal.vdl --all-properties
5. Generate counterexample:
     vdl_2026_plus check reader_fairness --find-counterexample

Expected Output:
  ✓ callback_safety_always: VERIFIED (states=1250)
  ✓ epoch_never_decreases: VERIFIED (states=1250)
  ? callback_completion: UNKNOWN (depth limit reached)
  ✓ grace_period_progress: VERIFIED (states=840)

Counterexamples:
  ✗ reader_fairness: VIOLATED
    Trace (12 steps):
      s0: {readers={}, epoch=0, ...}
      s1: rcu_read_lock(1) → {readers={1}, ...}
      s2: rcu_read_unlock(1) → {readers={}, ...}
      ...
      s12: Reader 2 never gets lock
*/
