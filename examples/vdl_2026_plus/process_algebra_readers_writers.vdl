//! VDL_2026+ Example: Readers-Writers with Process Algebra
//!
//! Demonstrates VDL_2026+ process algebra for concurrent systems.
//!
//! This extends traditional state-based modeling with:
//! - Process definitions (CCS/CSP style)
//! - Parallel composition (||)
//! - Interleaving semantics
//! - Synchronization channels
//!
//! Compared to VDL_2026, VDL_2026+ allows expressing concurrent behavior as:
//! - Composable processes
//! - Explicit communication channels
//! - Non-deterministic choice

type RWState = {
  readers: Set<Nat>,
  writer: Nat,  // 0 = none
  waiting_readers: Set<Nat>,
  waiting_writers: Set<Nat>
}

//
// VDL_2026 Invariants
//

inv no_concurrent_writer_reader(s: RWState) =
  s.writer != 0 implies card(s.readers) == 0

inv at_most_one_writer(s: RWState) =
  s.writer == 0 || card(s.readers) == 0

inv readers_and_writer_disjoint(s: RWState) =
  forall r in s.readers: r != s.writer

//
// VDL_2026+ Process Algebra
//

// Reader process
process Reader(id: Nat) =
  read_request(id) ->
  (choice
    read_acquire(id) -> read_release(id) -> Reader(id)
  | read_blocked(id) -> Reader(id))

// Writer process
process Writer(id: Nat) =
  write_request(id) ->
  (choice
    write_acquire(id) -> write_release(id) -> Writer(id)
  | write_blocked(id) -> Writer(id))

// System composition: 2 readers || 1 writer
process System =
  parallel
    Reader(1)
  | Reader(2)
  | Writer(3)

//
// VDL_2026+ Temporal Properties
//

// SAFETY: No concurrent writer and readers
temporal property writer_reader_exclusion =
  always(state.writer != 0 implies card(state.readers) == 0)

// SAFETY: At most one writer
temporal property single_writer =
  always(state.writer == 0 || card(s.readers) == 0)

// LIVENESS: Read requests eventually granted
temporal property reader_progress =
  always(
    forall r in state.waiting_readers:
      eventually(r in state.readers)
  )

// LIVENESS: Write requests eventually granted
temporal property writer_progress =
  always(
    forall w in state.waiting_writers:
      eventually(state.writer == w)
  )

// FAIRNESS: No reader starvation
temporal property reader_fairness =
  always(
    forall r: Nat:
      infinitely_often(r in state.waiting_readers) implies
      infinitely_often(r in state.readers)
  )

// FAIRNESS: No writer starvation
temporal property writer_fairness =
  always(
    forall w: Nat:
      infinitely_often(w in state.waiting_writers) implies
      infinitely_often(state.writer == w)
  )

// RESPONSE: Read request leads to read access
temporal property read_response =
  forall r: Nat:
    (r in state.waiting_readers) leads_to (r in state.readers)

// RESPONSE: Write request leads to write access
temporal property write_response =
  forall w: Nat:
    (w in state.waiting_writers) leads_to (state.writer == w)

//
// Transitions
//

transition read_request(s: RWState, r: Nat) -> RWState
pre r > 0 and r < 100 and
    r not_in s.readers and
    r not_in s.waiting_readers
post if s.writer == 0 then
       s'.readers == s.readers union {r} and
       s'.writer == s.writer and
       s'.waiting_readers == s.waiting_readers and
       s'.waiting_writers == s.waiting_writers
     else
       s'.readers == s.readers and
       s'.writer == s.writer and
       s'.waiting_readers == s.waiting_readers union {r} and
       s'.waiting_writers == s.waiting_writers

transition read_acquire(s: RWState, r: Nat) -> RWState
pre r in s.waiting_readers and s.writer == 0
post s'.readers == s.readers union {r} and
     s'.writer == s.writer and
     s'.waiting_readers == s.waiting_readers \ {r} and
     s'.waiting_writers == s.waiting_writers

transition read_release(s: RWState, r: Nat) -> RWState
pre r in s.readers
post s'.readers == s.readers \ {r} and
     s'.writer == s.writer and
     s'.waiting_readers == s.waiting_readers and
     s'.waiting_writers == s.waiting_writers

transition write_request(s: RWState, w: Nat) -> RWState
pre w > 0 and w < 100 and
    s.writer == 0 and
    w not_in s.waiting_writers
post if card(s.readers) == 0 then
       s'.readers == s.readers and
       s'.writer == w and
       s'.waiting_readers == s.waiting_readers and
       s'.waiting_writers == s.waiting_writers
     else
       s'.readers == s.readers and
       s'.writer == s.writer and
       s'.waiting_readers == s.waiting_readers and
       s'.waiting_writers == s.waiting_writers union {w}

transition write_acquire(s: RWState, w: Nat) -> RWState
pre w in s.waiting_writers and
    card(s.readers) == 0 and
    s.writer == 0
post s'.readers == s.readers and
     s'.writer == w and
     s'.waiting_readers == s.waiting_readers and
     s'.waiting_writers == s.waiting_writers \ {w}

transition write_release(s: RWState, w: Nat) -> RWState
pre s.writer == w
post s'.readers == s.readers and
     s'.writer == 0 and
     s'.waiting_readers == s.waiting_readers and
     s'.waiting_writers == s.waiting_writers

//
// VDL_2026+ vs CSP/CCS Comparison
//

/*
CSP version:

READER(id) = read_req!id ->
             (read_acq!id -> read_rel!id -> READER(id)
              [] read_blk!id -> READER(id))

WRITER(id) = write_req!id ->
             (write_acq!id -> write_rel!id -> WRITER(id)
              [] write_blk!id -> WRITER(id))

SYSTEM = READER(1) ||| READER(2) ||| WRITER(3)

VDL_2026+ advantages:
1. Integrated state (readers, writer sets) vs separate processes
2. Temporal properties directly checkable (CSP uses refinement)
3. Explicit state invariants alongside process algebra
4. Model checking with counterexamples
5. Unified specification language

CSP advantages:
1. Mature FDR refinement checker
2. Established theory and semantics
3. Trace/failure semantics well-understood

VDL_2026+ combines state-based (Z-notation) with process algebra (CSP).
*/

//
// How to Use
//

/*
1. Parse: vdl_2026_plus parse process_algebra_readers_writers.vdl
2. Model check safety:
     vdl_2026_plus check writer_reader_exclusion --depth 30
3. Model check liveness with fairness:
     vdl_2026_plus check reader_progress --depth 50 --fairness strong
4. Check all temporal properties:
     vdl_2026_plus verify process_algebra_readers_writers.vdl --all-properties
5. Simulate process traces:
     vdl_2026_plus simulate System --steps 20

Expected Output:
  ✓ writer_reader_exclusion: VERIFIED (states=2450)
  ✓ single_writer: VERIFIED (states=2450)
  ✓ reader_progress: VERIFIED (states=5200, fairness=weak)
  ✓ writer_progress: VERIFIED (states=5200, fairness=weak)
  ? reader_fairness: UNKNOWN (requires strong fairness)
  ? writer_fairness: UNKNOWN (requires strong fairness)

Process trace (20 steps):
  s0: {readers={}, writer=0}
  read_request(1) → s1: {readers={1}, writer=0}
  read_request(2) → s2: {readers={1,2}, writer=0}
  write_request(3) → s3: {readers={1,2}, writer=0, waiting_writers={3}}
  read_release(1) → s4: {readers={2}, writer=0, waiting_writers={3}}
  read_release(2) → s5: {readers={}, writer=0, waiting_writers={3}}
  write_acquire(3) → s6: {readers={}, writer=3, waiting_writers={}}
  ...
*/
